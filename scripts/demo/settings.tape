# Shared by every demo tape: about 100 columns by 30 lines.
Set Shell bash
Set FontSize 20
Set Width 1360
Set Height 790
Set Padding 12
Set TypingSpeed 60ms
Set Theme { "name": "demo", "background": "#1c1c1c", "foreground": "#bcbcbc", "cursor": "#bcbcbc", "selection": "#3a3a3a", "black": "#1c1c1c", "red": "#d75f5f", "green": "#87af87", "yellow": "#afaf87", "blue": "#5f87af", "magenta": "#af87af", "cyan": "#5f8787", "white": "#9e9e9e", "brightBlack": "#767676", "brightRed": "#d75f87", "brightGreen": "#87d787", "brightYellow": "#d7af87", "brightBlue": "#5fafd7", "brightMagenta": "#d787d7", "brightCyan": "#87afaf", "brightWhite": "#bcbcbc" }
